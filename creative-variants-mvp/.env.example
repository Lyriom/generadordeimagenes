# ---------------------------------------------------------------- aplicación
APP_NAME=Creative Variants MVP
DATA_DIR=/app/data

# ---------------------------------------------------------- artes grandes / PSD
# Los KV en PSD pesan 60-100 MB. Alternativa recomendada: dejarlos en data/ingest
# y crear el proyecto con POST /projects/from-ingest (no pasan por el navegador).
INGEST_DIR=/app/data/ingest
PSD_MAX_LAYERS=60
PSD_MIN_OPAQUE_RATIO=0.002

# ------------------------------------------------------------ límites de subida
MAX_UPLOAD_MB=250
MIN_IMAGE_SIDE=200
MAX_IMAGE_SIDE=8000

# ------------------------------------------------------------- segmentación
# auto | sam | local | manual   (auto usa SAM solo si el checkpoint existe)
SEGMENTATION_PROVIDER=auto
# Los modelos NO se descargan solos. Vea backend/requirements-sam.txt.
# SAM_CHECKPOINT=/models/sam2.1_hiera_small.pt
# SAM_VARIANT=sam2
# SAM_MODEL_TYPE=configs/sam2.1/sam2.1_hiera_s.yaml

# --------------------------------------------------------------------- OCR
# PaddleOCR es opcional: si no está instalado, la app avisa y permite crear
# las capas de texto a mano.
ENABLE_OCR=true
OCR_LANG=es

# --------------------------------------------------------------- inpainting
# auto | opencv | magnific | openai | flux | adobe
INPAINTING_PROVIDER=auto

# ----------------------------------------------------------------- Magnific
# Una sola clave abre todo el catálogo (Mystic, Flux, Seedream, Ideogram…).
# Pegue aquí su clave de https://www.magnific.com/user/organization/api-keys
MAGNIFIC_API_KEY=
# Modelo por defecto. Se puede cambiar por pieza desde la interfaz.
# ideogram-image-edit | mystic | flux-kontext-pro | flux-kontext-max |
# flux-2-pro | flux-2-flex | flux-2-turbo | flux-2-klein |
# seedream-v4-edit | seedream-v4-5-edit | seedream-v5-lite-edit |
# seedream-v5-pro-edit | gemini-2-5-flash-image-preview |
# nano-banana-pro | nano-banana-pro-flash
MAGNIFIC_MODEL=ideogram-image-edit
MAGNIFIC_BASE_URL=https://api.magnific.com
# Fotos de ambiente: modelo que separa el producto del decorado. Tiene que
# entender la instrucción, así que no puede ser el de máscara.
MAGNIFIC_SCENE_MODEL=flux-kontext-max
# 1k | 2k | 4k (los modelos que no la soportan la ignoran)
MAGNIFIC_RESOLUTION=2k
# Ideogram: TURBO | DEFAULT | QUALITY
MAGNIFIC_RENDERING_SPEED=QUALITY
# Mystic: realism | fluid | zen | flexible | super_real | editorial_portraits
MAGNIFIC_MYSTIC_MODEL=realism
# Mystic: automatic | magnific_illusio | magnific_sharpy | magnific_sparkle
MAGNIFIC_ENGINE=automatic
MAGNIFIC_STRUCTURE_STRENGTH=70
MAGNIFIC_ADHERENCE=60
MAGNIFIC_HDR=40
MAGNIFIC_CREATIVE_DETAILING=20
# Bajo este tamaño la imagen viaja en base64; por encima se sube primero.
MAGNIFIC_INLINE_MAX_MB=6
# Suavizado del borde al pegar lo generado sobre el arte original.
MAGNIFIC_FEATHER=6

# ------------------------------------------------------------------- OpenAI
# Para activar fondos IA, pegue su clave después del signo igual.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/edits
# BFL_API_KEY=
# BFL_ENDPOINT=https://api.bfl.ai/v1/flux-pro-1.0-fill
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_UPLOAD_BASE_URL=

# ------------------------------------------------------------------- render
DEFAULT_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
DEFAULT_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
MIN_VARIANTS=4
MAX_VARIANTS=30
PROVIDER_TIMEOUT=180

# ----------------------------------------------------------------- frontend
# Para ejecución local sin Docker use http://localhost:8000
BACKEND_URL=http://backend:8000
REQUEST_TIMEOUT=300

# ---------------------------------------------------------------- acceso web
# Solo para el despliegue (docker-compose.prod.yml): el proxy del puerto 8014
# pide usuario y contraseña. Sin esto, quien dé con la URL gasta los créditos.
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'su-clave'
#
# Los `$` del hash van DOBLES: Compose interpreta `$algo` como una variable.
CV_USER=equipo
CV_PASSWORD_HASH=

# Dirección pública. Sin definir escucha en :8014 por HTTP, que es lo que hay
# que dejar si el servidor ya tiene un proxy sirviendo otros proyectos: basta
# con que ese proxy reenvíe el subdominio al 8014.
# Si en cambio los puertos 80 y 443 están libres, poner aquí el subdominio y
# añadir docker-compose.dominio.yml: Caddy saca el certificado él solo.
# CV_SITE_ADDRESS=generador.misiva.com
