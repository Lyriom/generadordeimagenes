---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0e16" />
    <meta
      name="description"
      content="Generador de variantes creativas multiformato desde key visuals."
    />
    <link rel="icon" href="/favicon.svg" />
    <title>Misiva · Creative Studio</title>
    <script is:inline>
      // Se aplica antes de pintar para que no haya un destello claro al
      // recargar con el tema oscuro elegido.
      try {
        var saved = localStorage.getItem("creative-theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (error) {
        /* modo privado: se queda con el tema del sistema */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#app-content">Ir al contenido</a>
    <div class="noise" aria-hidden="true"></div>
    <button id="menu-scrim" class="scrim" type="button" tabindex="-1" aria-label="Cerrar menú"></button>

    <div id="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/" aria-label="Creative Studio">
          <span class="brand-mark"><i></i><i></i><i></i></span>
          <span><strong>Creative</strong><small>STUDIO</small></span>
        </a>

        <nav id="main-nav" aria-label="Secciones">
          <span class="nav-label">Flujo de trabajo</span>
          <button class="nav-item is-active" data-view="campaign" title="Campaña (tecla 1)">
            <span class="nav-icon" aria-hidden="true">1</span>
            <span>Campaña</span>
            <span class="nav-hint" aria-hidden="true">1</span>
          </button>
          <button class="nav-item" data-view="layers" title="Capas y KV (tecla 2)">
            <span class="nav-icon" aria-hidden="true">2</span>
            <span>Capas y KV</span>
            <span class="nav-hint" aria-hidden="true">2</span>
          </button>
          <button class="nav-item" data-view="generate" title="Generar (tecla 3)">
            <span class="nav-icon" aria-hidden="true">3</span>
            <span>Generar</span>
            <span class="nav-hint" aria-hidden="true">3</span>
          </button>
          <button class="nav-item" data-view="results" title="Resultados (tecla 4)">
            <span class="nav-icon" aria-hidden="true">4</span>
            <span>Resultados</span>
            <span class="nav-hint" aria-hidden="true">4</span>
          </button>
        </nav>

        <div class="sidebar-project" id="sidebar-project">
          <span class="eyebrow">SIN CAMPAÑA</span>
          <strong>Carga tu primer KV</strong>
          <small>PSD, PSB, PNG o JPG</small>
        </div>

        <div class="engine-status" id="engine-status">
          <span class="status-dot"></span>
          <div><strong>Conectando motor</strong><small>Comprobando servicios…</small></div>
        </div>
      </aside>

      <main class="workspace">
        <header class="topbar">
          <button id="mobile-menu" class="icon-button mobile-only" aria-label="Abrir menú">☰</button>
          <div class="crumbs">
            <span>Misiva</span><b>/</b><strong id="view-name">Campaña</strong>
          </div>
          <div class="top-actions">
            <button
              class="icon-button"
              id="theme-toggle"
              aria-label="Cambiar entre tema claro y oscuro"
              title="Cambiar tema"
            >◐</button>
            <button class="ghost-button" id="refresh-button" title="Actualizar (tecla R)">
              ↻ <span>Actualizar</span>
            </button>
            <span class="live-pill"><i></i><span>Motor conectado</span></span>
          </div>
        </header>

        <section id="app-content" class="content" aria-live="polite" tabindex="-1">
          <div class="loading-state">
            <div class="loader"></div>
            <strong>Preparando Creative Studio</strong>
            <span>Conectando con el motor de variantes</span>
          </div>
        </section>
      </main>
    </div>

    <div id="toast-region" class="toast-region" aria-live="assertive"></div>
    <div id="busy-overlay" class="busy-overlay" hidden>
      <div class="busy-card">
        <div class="loader large"></div>
        <strong id="busy-title">Procesando…</strong>
        <span id="busy-detail">Esto puede tomar unos minutos.</span>
        <div class="progress-track"><i id="busy-progress"></i></div>
      </div>
    </div>

    <script>
      import { mountApp } from "../scripts/app";
      mountApp();
    </script>

    <script is:inline>
      // Chrome de la interfaz: tema, menú móvil y atajos. Vive aparte de la
      // aplicación para que siga respondiendo aunque una vista falle al cargar.
      (function () {
        var root = document.documentElement;

        function currentTheme() {
          if (root.dataset.theme) return root.dataset.theme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        var toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () {
            var next = currentTheme() === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try {
              localStorage.setItem("creative-theme", next);
            } catch (error) {
              /* sin persistencia, el cambio vale para esta pestaña */
            }
          });
        }

        function closeMenu() {
          document.body.classList.remove("menu-open");
        }
        var scrim = document.getElementById("menu-scrim");
        if (scrim) scrim.addEventListener("click", closeMenu);

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") closeMenu();

          // Los atajos no deben dispararse mientras se escribe.
          var node = event.target;
          var typing =
            node instanceof HTMLElement &&
            (node.isContentEditable ||
              /^(INPUT|TEXTAREA|SELECT)$/.test(node.tagName));
          if (typing || event.metaKey || event.ctrlKey || event.altKey) return;

          if (event.key >= "1" && event.key <= "4") {
            var items = document.querySelectorAll(".nav-item");
            var target = items[Number(event.key) - 1];
            if (target) target.click();
            return;
          }
          if (event.key === "r" || event.key === "R") {
            var refresh = document.getElementById("refresh-button");
            if (refresh) refresh.click();
          }
        });
      })();
    </script>
  </body>
</html>
