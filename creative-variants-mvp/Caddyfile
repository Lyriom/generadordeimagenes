# Puerta de entrada única. Detrás quedan Streamlit, la API y Redis, ninguno
# publicado: al exterior solo se llega por aquí, y solo con contraseña.
#
# La dirección se elige con CV_SITE_ADDRESS en el .env:
#
#   sin definir              → :8014, HTTP. Para poner detrás del proxy que ya
#                              tenga el servidor (nginx, Traefik, otro Caddy).
#   generador.misiva.com     → ese dominio, con HTTPS y certificado automático.
#                              Requiere publicar los puertos 80 y 443:
#                              docker-compose.dominio.yml hace eso.
{
	admin off
}

{$CV_SITE_ADDRESS::8014} {
	# Contraseña de acceso, quitada a petición del equipo el 01/09/2026.
	# Para volver a ponerla: descomente estas tres líneas, compruebe que
	# CV_PASSWORD_HASH está en el .env del servidor y reinicie el proxy.
	# basic_auth {
	# 	{$CV_USER:equipo} {$CV_PASSWORD_HASH}
	# }

	# El HTML nunca debe quedar guardado: contiene los nombres hash de los chunks
	# JavaScript de la versión de Streamlit que está activa en ese momento.
	@index path / /index.html
	header @index Cache-Control "no-store, max-age=0"

	# Streamlit habla por websocket; Caddy lo pasa sin configurar nada. Durante
	# un deploy Compose reemplaza el frontend durante unos segundos. Los GET de
	# HTML/chunks esperan y reintentan, en vez de dejar un error permanente en la
	# pestaña que el usuario ya tenía abierta.
	reverse_proxy frontend:8501 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	# Los PSD llegan a 200 MB.
	request_body {
		max_size 300MB
	}

	log {
		output stdout
		format console
	}
}
